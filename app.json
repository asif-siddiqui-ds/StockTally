{
  "expo": {
    "name": "StockTally",
    "slug": "StockTally",
    "version": "2.1.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stocktally",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.asif.Stocktally",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Allow StockTally to save generated files and documents to your photo library.",
        "NSCameraUsageDescription": "StockTally uses the camera for barcode and product scanning.",
        "NSPhotoLibraryUsageDescription": "StockTally uses your photo library to select business logos and scan product or invoice images.",
        "UIBackgroundModes": [
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.asif.Stocktally",
      "permissions": [
        "CAMERA"
      ]
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/e5895148-30d8-4010-9c1b-5b7f3adc3c6d",
      "fallbackToCacheTimeout": 0
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
       [
            "expo-image-picker",
            {
                "microphonePermission": false
            }
        ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },

    "extra": {
      "appwriteEndpoint": "https://fra.cloud.appwrite.io/v1",
      "appwriteProjectId": "68215c9f00161f204345",
      "excludeModules": [
        "expo-sharing"
      ],
      "router": {},
      "eas": {
        "projectId": "e5895148-30d8-4010-9c1b-5b7f3adc3c6d"
      },
      "revenuecatApiKey": "appl_baZiIBClpFlhCpNAJFYjduVfJxp"
    }
  }
}