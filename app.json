{
  "expo": {
    "name": "StockTally",
    "slug": "StockTally",
    "version": "2.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stocktally",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "buildNumber": "47",
      "bundleIdentifier": "com.asif.Stocktally",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Allow this app to save files to your photo library",
