{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },

    "production": {
      "distribution": "store",
      "ios": {
        "autoIncrement": true,
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    }
  },

  "submit": {
    "production": {}
  }
}